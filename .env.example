# ─────────────────────────────────────────────
# CONSENTEMENT APP — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local
# ─────────────────────────────────────────────

# ── Vercel CI/CD (généré automatiquement par Vercel CLI) ──────────────────────
# Requis uniquement en CI — ne pas renseigner en développement local
VERCEL_OIDC_TOKEN=

# ── Build mobile (Capacitor) ──────────────────────────────────────────────────
# Passer à "true" pour générer un export statique compatible Capacitor
# Commande : NEXT_PUBLIC_MOBILE=true next build && npx cap sync
NEXT_PUBLIC_MOBILE=false

# ── Backend PocketBase (Hetzner self-hosted) ─────────────────────────────────
NEXT_PUBLIC_PB_URL=http://localhost:8090

# ── Analytics (à venir — non actif) ─────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
