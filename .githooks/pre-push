#!/bin/sh
set -e

echo "Pre-push [1/3]: lint..."
npm run lint

echo "Pre-push [2/3]: tsc..."
./node_modules/.bin/tsc --noEmit --project tsconfig.check.json

echo "Pre-push [3/3]: build..."
# Next.js 15.x bug: exit code non-nul sur "Collecting build traces" en mode output:'export'
# même quand le build static est réussi. On vérifie l'artefact réel.
npm run build || {
  if [ -f out/index.html ]; then
    echo "  ⚠ Build trace warning ignoré (out/index.html présent — export OK)"
  else
    echo "  ✗ Build échoué (out/index.html manquant)"
    exit 1
  fi
}

echo "OK — all checks passed."
