{
  "expo": {
    "name": "OuiClair",
    "slug": "ouiclair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.consentement.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Utilisé pour l'effet gyroscope des cartes"
      }
    },
    "android": {
      "package": "fr.consentement.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sensors",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Cette app n'utilise pas tes données à des fins publicitaires. Cette demande est requise par iOS."
        }
      ],
      ["@sentry/react-native/expo"]
    ],
    "extra": {
      "eas": {
        "projectId": "c76ebde9-e454-4b76-a8ec-79dc51f94ea4"
      }
    }
  }
}
