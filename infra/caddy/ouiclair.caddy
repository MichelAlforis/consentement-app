# ============================================================
# SITE VITRINE - ouiclair.com
# Hébergement : Hetzner /srv/ouiclair/vitrine (export statique Next.js)
# ============================================================

ouiclair.com, www.ouiclair.com {
    root * /srv/ouiclair/vitrine

    file_server

    # Fallback 404 personnalisé
    handle_errors {
        rewrite * /404.html
        file_server
    }

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/ouiclair.log {
            roll_size 50mb
            roll_keep 3
        }
        format json
    }
}
