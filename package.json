{
  "name": "ouiclair-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/vitrine"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "vitrine:dev": "npm run dev --workspace=apps/vitrine",
    "vitrine:build": "npm run build --workspace=apps/vitrine",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npx tsc --noEmit && npm run test:unit",
    "build:static": "next build",
    "build:mobile": "NEXT_PUBLIC_MOBILE=true next build && npx cap sync",
    "build:main": "NEXT_PUBLIC_APP_VARIANT=main APP_VARIANT=main next build",
    "build:adult": "NEXT_PUBLIC_APP_VARIANT=adult APP_VARIANT=adult next build",
    "cap:sync": "npx cap sync",
    "cap:sync:adult": "APP_VARIANT=adult npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "detect-gpu": "^5.0.70",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.5.15",
    "pocketbase": "^0.26.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings=0"
  }
}
